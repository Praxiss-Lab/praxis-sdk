# This MANIFEST.in file tells setuptools which files to include 
# in the sdist package distribution used for building docker image

# ==============================================================================
# Root-level workspace files
# ==============================================================================
include pyproject.toml
include uv.lock

# ==============================================================================
# praxis-sdk
# ==============================================================================
include praxis-sdk/pyproject.toml
recursive-include praxis-sdk *.py
recursive-include praxis-sdk *.j2
recursive-include praxis-sdk py.typed

# ==============================================================================
# praxis-tools
# ==============================================================================
include praxis-tools/pyproject.toml
recursive-include praxis-tools *.py
recursive-include praxis-tools *.j2
recursive-include praxis-tools py.typed

# ==============================================================================
# praxis-workspace
# ==============================================================================
include praxis-workspace/pyproject.toml
recursive-include praxis-workspace *.py
recursive-include praxis-workspace py.typed

# ==============================================================================
# praxis-agent-server
# ==============================================================================
include praxis-agent-server/pyproject.toml
recursive-include praxis-agent-server *.py
recursive-include praxis-agent-server py.typed

# Docker build files
include praxis-agent-server/openhands/agent_server/docker/Dockerfile
include praxis-agent-server/openhands/agent_server/docker/wallpaper.svg

# PyInstaller spec
include praxis-agent-server/openhands/agent_server/agent-server.spec

# VSCode extensions
recursive-include praxis-agent-server/openhands/agent_server/vscode_extensions *
